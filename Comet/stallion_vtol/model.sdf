<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.9">
  <model name="comet" canonical_link="base_link">
    <!--R2 split update: w_R2 and ail_R3 are INBOARD halves; w_R2.1 and ail_R3.1 are OUTBOARD halves. Assumes 80 mm original span. Both half meshes MUST be exported in their original uncut-part coordinate frames.-->
    <!--Left aileron: four independent joints share ArduPilot channel 0; coefficients preserve nominal intact roll derivative.-->
    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.950</mass>
        <inertia>
          <ixx>0.15798</ixx>
          <ixy>0</ixy>
          <ixz>0.0069325</ixz>
          <iyy>0.2497</iyy>
          <iyz>0</iyz>
          <izz>0.40538</izz>
        </inertia>
      </inertial>
      <collision name="base_link_collision">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://stallion_vtol/meshes/base_link.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="fuselage_visual">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://stallion_vtol/meshes/base_link.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
        </material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>1</update_rate>
      </sensor>
    </link>
    <joint name="left_aileron_joint" type="revolute">
      <parent>base_link</parent>
      <child>ail_L1</child>
      <pose relative_to="base_link">-0.067 0.295 0.0017 -1.571 0 0.0166</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.17453</lower>
          <upper>0.17453</upper>
