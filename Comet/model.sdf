    </plugin>
    
    
    <plugin name="ArduPilotPlugin"
      filename="ArduPilotPlugin">
      <!-- Port settings. -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <have_32_channels>0</have_32_channels>

      <!-- Frame transforms.-->
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 1.57079632</gazeboXYZToNED>

      <!-- Sensors. -->
      <imuName>base_link::imu_sensor</imuName>

      <!--
          Joint range -30/+30 deg

          SERVO1_FUNCTION   4 (Aileron)
          SERVO1_MAX        2000
          SERVO1_MIN        1000
          SERVO1_REVERSED   0
          SERVO1_TRIM       1500
       -->
      <control channel="0">
        <jointName>left_aileron_joint</jointName>
        <multiplier>-1.0471976</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/left_aileron_joint/cmd_pos</cmd_topic>
      </control>

      <control channel="0">
        <jointName>right_aileron_joint</jointName>
        <multiplier>1.0471976</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/right_aileron_joint/cmd_pos</cmd_topic>
      </control>

      <!--
          Joint range -30/+30 deg

          SERVO2_FUNCTION   79 (Left V-Tail)
          SERVO2_MAX        2000
          SERVO2_MIN        1000
          SERVO2_REVERSED   0
          SERVO2_TRIM       1500
       -->
      <control channel="1">
        <jointName>left_elevator_joint</jointName>
        <multiplier>1.0471976</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/left_elevator_joint/cmd_pos</cmd_topic>
      </control>
      
      <control channel="1">
        <jointName>right_elevator_joint</jointName>
        <multiplier>1.0471976</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/right_elevator_joint/cmd_pos</cmd_topic>
        
      </control>

      <!--/fault/left_ruddervator_raw
          SERVO3_FUNCTION   70 (Throttle)
          SERVO3_MAX        2000
          SERVO3_MIN        1000
          SERVO3_REVERSED   0
          SERVO3_TRIM       1000
       -->
      <control channel="2"> 
        <jointName>motor_joint_left</jointName>
        <multiplier>1000</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>1</i_max>
        <i_min>-1</i_min>
        <cmd_max>5.0</cmd_max>
        <cmd_min>-5.0</cmd_min>
      </control>
      
      <control channel="2"> 
        <jointName>motor_joint_right</jointName>
        <multiplier>1000</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>1</i_max>
        <i_min>-1</i_min>
        <cmd_max>5.0</cmd_max>
        <cmd_min>-5.0</cmd_min>
      </control>

      <!--
          Joint range -30/+30 deg

          SERVO4_FUNCTION   80 (Right V-Tail)
          SERVO4_MAX        2000
          SERVO4_MIN        1000
          SERVO4_REVERSED   0
          SERVO4_TRIM       1500
       -->
      <control channel="3">
        <jointName>rudder_joint</jointName>
        <multiplier>1.0471976</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/rudder_joint/cmd_pos</cmd_topic>
      </control>

    </plugin>
  </model>
  
</sdf>


