    <link name="motor_link_left">
      <pose degrees="true">0.125 0.30 0.0025 0 -90 0</pose>
      <inertial>
        
        <mass>0.001</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
