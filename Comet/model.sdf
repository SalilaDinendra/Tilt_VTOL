<?xml version="1.0"?>
<sdf version="1.9">
  
  <model name="comet">

    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.15798</ixx>
          <ixy>0</ixy>
          <ixz>0.0069325</ixz>
          <iyy>0.2497</iyy>
          <iyz>0</iyz>
          <izz>0.40538</izz>
        </inertia>
      </inertial>

      <collision name='base_link_collision'>
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://stallion_vtol/meshes/base_link.dae</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="fuselage_visual">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://stallion_vtol/meshes/base_link.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
                <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>


      <!-- Sensors. -->
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>1</update_rate>
      </sensor>
    </link>
    
    <joint name='left_aileron_joint' type='revolute'>
      <parent>base_link</parent>
      <child>left_aileron_link</child>
      <pose relative_to='base_link'>-0.067 0.295 0.0017 -1.571 0 0.0166</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.17453</lower>
          <upper>0.17453</upper>
          <effort>5.0</effort>
          <velocity>10.0</velocity>
        </limit>
        <dynamics>
          <damping>0.0001</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='left_aileron_link'>
      <pose relative_to='left_aileron_joint' degrees='true'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.019319410829812499 -0.0015985079490108401 0.118957401128077 0 0 0</pose>
        <mass>0.016</mass>
        <inertia>
          <ixx>0.00044028529108299999</ixx>
          <ixy>1.35503903996988e-06</ixy>
          <ixz>5.0702719884528399e-06</ixz>
          <iyy>0.00045603458419739398</iyy>
          <iyz>-4.2973911951881198e-07</iyz>
          <izz>1.7003421149911501e-05</izz>
        </inertia>
      </inertial>
      
      <visual name='L_Aileron_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://stallion_vtol/meshes/L_Aileron.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.5 0 0.5 1</diffuse>
          <ambient>0.5 0 0.5 1</ambient>
        </material>
      </visual>
    </link>
    
    
    <joint name='right_aileron_joint' type='revolute'>
      <parent>base_link</parent>
      <child>right_aileron_link</child>
      <pose relative_to='base_link'>-0.0667 -0.295 0.0017 1.571 0 -0.0166</pose>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-0.17452999999999999</lower>
          <upper>0.17452999999999999</upper>
          <effort>5.0</effort>
          <velocity>10.0</velocity>
        </limit>
        <dynamics>
          <damping>0.0001</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='right_aileron_link'>
      <pose relative_to='right_aileron_joint' degrees='true'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.0187801219375088 -0.0017102252922158701 0.118960916571928 0 0 0</pose>
        <mass>0.016</mass>
        <inertia>
          <ixx>0.00044034243406479098</ixx>
          <ixy>-1.4819480765882799e-06</ixy>
          <ixz>-3.3799692095839499e-06</ixz>
          <iyy>0.00045601138992668798</iyy>
          <iyz>-3.1787437036860999e-07</iyz>
          <izz>1.6969472438767499e-05</izz>
        </inertia>
      </inertial>
      <collision name='R_Aileron_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://stallion_vtol/meshes/R_Aileron.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name='R_Aileron_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://stallion_vtol/meshes/R_Aileron.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.5 0 0.5 1</diffuse>
          <ambient>0.5 0 0.5 1</ambient>
        </material>
      </visual>
    </link>
    
    <joint name='rudder_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rudder_link</child>
      <pose relative_to='base_link'>-0.546 0 0.0371 -1.571 -0.156 0</pose>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-0.17453</lower>
          <upper>0.17453</upper>
          <effort>5.0</effort>
          <velocity>10.0</velocity>
        </limit>
        <dynamics>
          <damping>0.0001</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='rudder_link'>
      <pose relative_to='rudder_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.0112 -0.042 0 0 0 0</pose>
        <mass>0.010</mass>
        <inertia>
          <ixx>8.6199016260957796e-05</ixx>
          <ixy>-5.6589289969212396e-12</ixy>
          <ixz>-4.8692063497864804e-07</ixz>
          <iyy>8.7366984895579199e-05</iyy>
          <iyz>3.3887043768425699e-10</iyz>
          <izz>1.2400412416049001e-06</izz>
        </inertia>
      </inertial>
      <collision name='Rudder_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://stallion_vtol/meshes/rudder_link.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name='Rudder_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://stallion_vtol/meshes/rudder_link.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.5 0 0.5 1</diffuse>
          <ambient>0.5 0 0.5 1</ambient>
        </material>
      </visual>
    </link> 
    
 
    <joint name='right_elevator_joint' type='revolute'>
